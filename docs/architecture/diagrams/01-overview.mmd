flowchart TD
    subgraph Consumer["消费侧"]
        C["原生客户端 / 应用 / Agent"] --> CLI["oi CLI / 客户端库"]
        C -.-> A["条件扩展：协议适配组件"]
        A -.-> CLI
    end
    subgraph OIS["OIS：Go / 可信管理与中继"]
        API["身份、目录、策略 API"] --> RELAY["授权配对与有界中继"]
        API <--> DB["持久身份 / 配置 / 策略"]
    end
    subgraph Controlled["受控环境"]
        OIC["OIC：登记、目标约束、通道"] --> P["独立能力服务"]
        Q["可选探针 / 观测归约"] --> OIC
        Q -->|无副作用检查| P
        P --> R["桌面 / 文件 / 设备 / 外部服务"]
    end
    CLI -->|HTTPS 发现与 Open| API
    CLI <-->|独立 WSS 数据腿| RELAY
    API <-->|WSS 控制：OIC 发起| OIC
    RELAY <-->|WSS 数据腿：OIC 发起| OIC
    OIC --> M["外部监控：有界导出"]
    API --> M
