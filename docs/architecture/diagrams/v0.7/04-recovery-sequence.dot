digraph G {
graph [bgcolor="white",pad="0.35",nodesep="0.5",ranksep="0.65",fontname="Noto Sans SC",fontsize=18,labelloc="t",splines=polyline];
node [shape=box,style="rounded,filled",fillcolor="#eef5ff",color="#5077a3",fontname="Noto Sans SC",fontsize=12,width=4.3,margin="0.35,0.2",penwidth=1.3];
edge [color="#52677f",fontname="Noto Sans SC",fontsize=10,arrowsize=0.8];
rankdir=TB;label="故障恢复｜重建边界已采用\n具体机制与恢复时限仍待验证";
 failure[label="OIS故障或失去权威"];
 old[label="停止新授权与续权\n现有通道到期或关闭",fillcolor="#ffe8e5"];
 single[label="受控重启\nPG或SQLite单实例"];
 ha[label="经验证的PG故障切换\n仅在G6通过后启用",style="rounded,dashed,filled",fillcolor="#fff1d6"];
 authority[label="建立有效权威\n拒绝旧任期与连接代数"];
 reg[label="OIC重认证与对账\n新连接；就绪观测从未知开始"];
 new[label="重新发现、授权与准入\n建立新通道",fillcolor="#e4f4e9"];
 business[label="业务恢复由提供方或消费者拥有\nOI不重放旧业务字节\n拒绝旧代数不能回滚已发生的效果",width=8.6,shape=note,fillcolor="#f5f6f8"];
 failure->old;old->single;old->ha;{rank=same;single;ha;}
 single->authority;ha->authority;authority->reg->new;
 new->business[style=dotted,arrowhead=none];

}
