digraph G {
graph [bgcolor="white",pad="0.35",nodesep="0.5",ranksep="0.65",fontname="Noto Sans SC",fontsize=18,labelloc="t",splines=polyline];
node [shape=box,style="rounded,filled",fillcolor="#eef5ff",color="#5077a3",fontname="Noto Sans SC",fontsize=12,width=4.3,margin="0.35,0.2",penwidth=1.3];
edge [color="#52677f",fontname="Noto Sans SC",fontsize=10,arrowsize=0.8];
rankdir=TB;newrank=true;label="存储部署｜共同契约与不同保证范围";
 contract[label="版本化存储契约\n配置、策略、审计与恢复元数据"];
 subgraph cluster_pg {label="";color="#a7bed8";pgapp[label="默认推荐PostgreSQL\n单OIS实例"];pg[label="PostgreSQL",shape=cylinder,fillcolor="#fff1d6"];pgapp->pg[dir=both];}
 subgraph cluster_sqlite {label="";color="#a7bed8";sqapp[label="显式选择SQLite\n单OIS与本地持久盘\n有界写入"];sq[label="SQLite与WAL\n索引、保留策略与维护",shape=cylinder,fillcolor="#fff1d6"];sqapp->sq[dir=both];}
 {rank=same;pgapp;sqapp;}
contract->pgapp[label="选择postgres驱动"];contract->sqapp[label="选择sqlite驱动"];
 subgraph cluster_ha {label="";style=dashed;color="#b58b49";entry[label="PG主备候选（G6）\n验证入口与活动权威"];active[label="活动OIS"];standby[label="备用OIS",style="rounded,dashed,filled"];shared[label="PG权威与部署恢复",shape=cylinder,fillcolor="#fff1d6"];entry->active;active->shared[dir=both];standby->shared[dir=both,style=dashed];}
 pg->entry[style=dashed,label="仅在故障验证后"];
 note[label="不从PG故障自动降级SQLite\nSQLite不是该主备方案的共享存储\n通道、就绪快照与业务载荷不作持久元数据",width=8.6,shape=note,fillcolor="#ffe8e5",color="#b76659"];
 sq->note[style=dotted,arrowhead=none];shared->note[style=dotted,arrowhead=none];

}
