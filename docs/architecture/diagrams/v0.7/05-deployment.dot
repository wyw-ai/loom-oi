digraph G {
graph [bgcolor="white",pad="0.35",nodesep="0.5",ranksep="0.65",fontname="Arial",fontsize=22,labelloc="t",splines=polyline];
node [shape=box,style="rounded,filled",fillcolor="#eef5ff",color="#5077a3",fontname="Arial",fontsize=15,margin="0.2,0.12",penwidth=1.3];
edge [color="#52677f",fontname="Arial",fontsize=11,arrowsize=0.8];
rankdir=TB;newrank=true;label="Storage profiles | Shared contract, different deployment guarantees";
 contract[label="Versioned Store contract\nConfiguration + policy + audit + recovery metadata"];
 subgraph cluster_pg {label="";color="#a7bed8";pgapp[label="Recommended PG default\nSingle OIS"];pg[label="PostgreSQL",shape=cylinder,fillcolor="#fff1d6"];pgapp->pg[dir=both];}
 subgraph cluster_sqlite {label="";color="#a7bed8";sqapp[label="Explicit SQLite selection\nSingle OIS + local durable disk\nbounded writer"];sq[label="SQLite + WAL\nindexes / retention / maintenance",shape=cylinder,fillcolor="#fff1d6"];sqapp->sq[dir=both];}
 {rank=same;pgapp;sqapp;}
contract->pgapp[label="driver=postgres"];contract->sqapp[label="driver=sqlite"];
 subgraph cluster_ha {label="";style=dashed;color="#b58b49";entry[label="PG HA candidate (G6)\nValidated entry / active authority"];active[label="Active OIS"];standby[label="Standby OIS",style="rounded,dashed,filled"];shared[label="PG authority + deployment recovery",shape=cylinder,fillcolor="#fff1d6"];entry->active;active->shared[dir=both];standby->shared[dir=both,style=dashed];}
 pg->entry[style=dashed,label="only after failure validation"];
 note[label="No automatic PG-to-SQLite failover\nSQLite is not the shared store for this HA profile\nChannels / Ready snapshots / business payloads are not durable metadata",shape=note,fillcolor="#ffe8e5",color="#b76659"];
 sq->note[style=dotted,arrowhead=none];shared->note[style=dotted,arrowhead=none];

}
