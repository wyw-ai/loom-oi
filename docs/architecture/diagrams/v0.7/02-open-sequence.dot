digraph G {
graph [bgcolor="white",pad="0.35",nodesep="0.5",ranksep="0.65",fontname="Noto Sans SC",fontsize=18,labelloc="t",splines=polyline];
node [shape=box,style="rounded,filled",fillcolor="#eef5ff",color="#5077a3",fontname="Noto Sans SC",fontsize=12,width=4.3,margin="0.35,0.2",penwidth=1.3];
edge [color="#52677f",fontname="Noto Sans SC",fontsize=10,arrowsize=0.8];
rankdir=TB;label="申请通道｜就绪提交前再次核验";
 discover[label="消费者发现暴露项\n可见不等于获准访问"];
 auth[label="OIS：主体、策略与目标版本\n当前权威与限额"];
 local[label="OIC：本地目标与当前连接\n就绪准入与预算"];
 prep[label="有界准备\nOIC拨号获准目标"];
 consumer[label="消费者附着数据腿\n身份与一次性票据"];
 provider[label="OIC附着数据腿\n身份与一次性票据"];
 check[label="两腿配齐后再次核验\n策略、版本、就绪与期限",shape=diamond,fillcolor="#fff1d6"];
 open[label="通道就绪（ChannelReady）\n原生字节流经过中继",fillcolor="#e4f4e9"];
 reject[label="拒绝、超时或撤销\n关闭两腿与目标连接\n释放预留资源",fillcolor="#ffe8e5",color="#b76659"];
 note[label="就绪前未转交载荷\n不证明连接本身没有业务副作用",width=8.6,shape=note,fillcolor="#f5f6f8"];
 discover->auth->local->prep;
 prep->consumer;prep->provider;{rank=same;consumer;provider;}
 consumer->check;provider->check;
 check->open[label="有效"];check->reject[label="变化或过期"];
 auth->reject[label="拒绝",style=dashed];local->reject[label="拒绝",style=dashed];
 open->note[style=dotted,arrowhead=none];

}
