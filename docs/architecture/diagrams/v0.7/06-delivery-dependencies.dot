digraph G {
graph [bgcolor="white",pad="0.35",nodesep="0.5",ranksep="0.65",fontname="Arial",fontsize=22,labelloc="t",splines=polyline];
node [shape=box,style="rounded,filled",fillcolor="#eef5ff",color="#5077a3",fontname="Arial",fontsize=15,margin="0.2,0.12",penwidth=1.3];
edge [color="#52677f",fontname="Arial",fontsize=11,arrowsize=0.8];
rankdir=TB;label="Evidence gates | No recorded passes in this revision";
 g0[label="G0 Design + adoption scope\nP1 entry"];
 g1[label="G1 Actual vertical path\nP1 exit / P2 entry"];
 g2[label="G2 Observation + admission\nLAB-005"];
 g3[label="G3 Real transport failures\nLAB-006"];
 g4[label="G4 Dual-store recovery\nLAB-006"];
 gate[label="G2 + G3 + G4 required\nP3 / P4 formal entry",shape=diamond,fillcolor="#fff1d6"];
 g5[label="G5 Target resource budget\nLAB-003"];
 g6[label="G6 PG HA failures\nLAB-006"];
 g7[label="G7 Real compatibility\nLAB-004"];
 single[label="Single-instance delivery\nG5 + G7 and all prerequisites",fillcolor="#e4f4e9"];
 ha[label="HA delivery\nG5 + G6 + G7 and prerequisites",fillcolor="#e4f4e9"];
 g0->g1;g1->g2;g1->g3;g1->g4;{rank=same;g2;g3;g4;}
 g2->gate;g3->gate;g4->gate;gate->g5;gate->g6;gate->g7;{rank=same;g5;g6;g7;}
 g5->single;g7->single;g5->ha;g6->ha;g7->ha;
 note[label="Blocked / NotRun / Failed / Inconclusive stop dependent stages\nSample collection and independent preparation may continue\nA valid register is NOT a passed experiment",shape=note,fillcolor="#ffe8e5"];
 single->note[style=invis];ha->note[style=invis];

}
