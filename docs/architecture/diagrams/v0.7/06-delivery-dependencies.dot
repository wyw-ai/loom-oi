digraph G {
graph [bgcolor="white",pad="0.35",nodesep="0.5",ranksep="0.65",fontname="Noto Sans SC",fontsize=18,labelloc="t",splines=polyline];
node [shape=box,style="rounded,filled",fillcolor="#eef5ff",color="#5077a3",fontname="Noto Sans SC",fontsize=12,width=4.3,margin="0.35,0.2",penwidth=1.3];
edge [color="#52677f",fontname="Noto Sans SC",fontsize=10,arrowsize=0.8];
rankdir=TB;label="开发阶段门槛｜设计采用与产品验证分开";
 g0[label="G0 设计入口已通过\nB1–B4已采用；P1可进入"];
 g1[label="G1 纵向闭环已通过\n资源修正与发布回读完成",fillcolor="#e4f4e9"];
 g2[label="G2 观测与准入\nLAB-005"];
 g3[label="G3 真实传输故障\nLAB-006"];
 g4[label="G4 双后端恢复已通过\n资源回归与发布回读完成",fillcolor="#e4f4e9"];
 gate[label="G2、G3、G4全部通过\nP3 / P4正式入口",shape=diamond,fillcolor="#fff1d6"];
 g5[label="G5 目标资源预算\nLAB-003"];
 g6[label="G6 PG主备故障\nLAB-006"];
 g7[label="G7 真实组合兼容\nLAB-004"];
 single[label="单实例交付\nG5、G7及所有前置",fillcolor="#e4f4e9"];
 ha[label="高可用交付\nG5、G6、G7及所有前置",fillcolor="#e4f4e9"];
 g0->g1;g1->g2;g1->g3;g1->g4;{rank=same;g2;g3;g4;}
 g2->gate;g3->gate;g4->gate;gate->g5;gate->g6;gate->g7;{rank=same;g5;g6;g7;}
 g5->single;g7->single;g5->ha;g6->ha;g7->ha;
 note[label="受阻、未运行、未通过或结论不足\n均阻止依赖阶段\n独立样本与物料准备可继续\n设计采用不等于产品验证通过",width=8.6,shape=note,fillcolor="#ffe8e5"];
 single->note[style=invis];ha->note[style=invis];

}
