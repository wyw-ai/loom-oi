digraph arbitration {
 graph [rankdir=TB, bgcolor="#F8FAFC", pad=0.4, nodesep=0.55, ranksep=0.65, fontname="Noto Sans SC", label="共享冲突资源的互斥与交接\n外部服务持有 · 设计提案 · 尚未实现与实测", labelloc=t, fontsize=20, fontcolor="#0F172A"];
 node [shape=box, style="rounded,filled", fontname="Noto Sans SC", fontsize=12, color="#94A3B8", fillcolor="white", margin="0.3,0.2", width=3.6];
 edge [fontname="Noto Sans SC", fontsize=10, color="#64748B", arrowsize=0.7];
 calls [label="多个业务入口／暴露项\n共享键鼠必须映射同一资源\n封闭绕过仲裁的路径", fillcolor="#EDE9FE", color="#A78BFA"];
 grant [label="单一外部仲裁权威\n校验主体、资源与实例\n发放有期限的回合所有权", fillcolor="#DCFCE7", color="#16A34A"];
 busy [label="资源被占用\n明确返回忙碌\n可选队列必须有界", fillcolor="#FEF3C7", color="#D97706"];
 round [label="有限交互回合\n重新观察、规划、动作、核验\n每次动作检查权限与当前代数", fillcolor="#DCFCE7", color="#16A34A"];
 stop [label="结束／断线／到期／重启\n禁止旧所有者发起新动作\n核实在途动作与旧执行器", fillcolor="#DBEAFE", color="#2563EB"];
 quiet [label="在途动作已结束\n且旧执行器无法再发动作？", shape=diamond, width=4.4, height=1.2, fillcolor="#DBEAFE", color="#2563EB"];
 release [label="允许交接给下一位\n新回合先重新观察\n历史业务结果可以仍未知", fillcolor="#DCFCE7", color="#16A34A"];
 quarantine [label="隔离该资源，禁止交接\n外部监督器或人工核实\n租约到期不等于动作停止", fillcolor="#FEE2E2", color="#DC2626"];
 calls -> grant [label="　按实际资源申请　"];
 grant -> busy [label="　被占用　"];
 grant -> round [label="　获得所有权　"];
 round -> stop [label="　有限动作／时间预算　"];
 stop -> quiet;
 quiet -> release [label="　已确认　"];
 quiet -> quarantine [label="　无法确认　"];
 quarantine -> quiet [style=dashed, label="　取得静止证据　", constraint=false];
 {rank=same;busy;round;}
 {rank=same;release;quarantine;}
}
