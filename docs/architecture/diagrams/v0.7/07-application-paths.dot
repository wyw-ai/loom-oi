digraph applications {
 graph [rankdir=TB, newrank=true, bgcolor="#F8FAFC", pad=0.35, nodesep=0.65, ranksep=0.65, compound=true, fontname="Noto Sans SC", label="loom-oi 应用优化方案\n基于已有案例的设计提案｜尚未实现与实测", labelloc=t, fontsize=21, fontcolor="#0F172A"];
 node [shape=box, style="rounded,filled", fontname="Noto Sans SC", fontsize=12, color="#94A3B8", fillcolor="white", margin="0.3,0.18", width=3.4];
 edge [fontname="Noto Sans SC", fontsize=10, color="#64748B", arrowsize=0.7];
 subgraph cluster_consumer {
  label="消费方负责工具与工作流"; margin=20; fontsize=17; style="rounded"; color="#A78BFA"; bgcolor="#F5F3FF";
  agent [label="Mac 上的智能体\n原生客户端", fillcolor="#EDE9FE"];
  harness [label="未来 Loom 工作流\n事件、记忆与任务记录", style="rounded,dashed", color="#A78BFA"];
  tool [label="外部工具接口\n明确目标与业务参数\n原生工具可直接接入", fillcolor="#EDE9FE"];
  {rank=same;agent;harness;}
  agent -> tool [label="结构化调用"];
  harness -> tool [style=dashed, label="后续上层接入"];
 }
 cli [label="oi 客户端\n发现、申请通道、附着", fillcolor="#DBEAFE", color="#2563EB"];
 ois [label="OIS｜可信中继\n目录、策略与有界数据流\n通道运行状态由 OI 管理\n不执行命令、界面操作或工作流", width=3.7, fillcolor="#DBEAFE", color="#2563EB"];
 tool -> cli [dir=both,label="原生业务协议"];
 agent -> cli [style=dashed,label="原生客户端路径"];
 cli -> ois [dir=both,label="认证后的通道"];
 subgraph cluster_ecs {
  label="场景一\n两台 ECS 主机各自部署"; color="#CBD5E1"; style="rounded"; bgcolor="#FFFFFF"; labelloc=b; fontsize=14; margin=20;
  oa [label="OIC｜通用接入\n允许端点与连接状态\n不解释业务操作", fillcolor="#DBEAFE", color="#2563EB"];
  ex [label="外部执行服务\n参数、脚本、结果与取消\n独立部署，可替换", fillcolor="#DCFCE7", color="#16A34A"];
  ws [label="受限进程与工作区\n不隐式重放业务请求", fillcolor="#F0FDF4"];
  oa -> ex [dir=both,label="固定本地目标"];
  ex -> ws [dir=both,label="提供方管理生命周期"];
 }
 subgraph cluster_device {
  label="场景二\n设备／桌面控制宿主"; color="#CBD5E1"; style="rounded"; bgcolor="#FFFFFF"; labelloc=b; fontsize=14; margin=20;
  ob [label="OIC｜通用接入\n允许端点与连接状态\n不解释业务操作", fillcolor="#DBEAFE", color="#2563EB"];
  ui [label="现成 MCP／业务适配\n统一资源仲裁\n待实现与验证", fillcolor="#DCFCE7", color="#16A34A"];
  device [label="电脑会话或安卓设备\n观察、操作、核验\n多窗口不等于输入隔离", fillcolor="#F0FDF4"];
  ob -> ui [dir=both,label="带版本的原生协议"];
  ui -> device [dir=both,label="提供方执行操作"];
 }
 subgraph cluster_pod {
  label="场景三\n一个选定 Pod（提案）"; color="#CBD5E1"; style="rounded"; bgcolor="#FFFFFF"; labelloc=b; fontsize=14; margin=20;
  oc [label="OIC｜通用接入\n允许端点与连接状态\n身份由部署方注入", fillcolor="#DBEAFE", color="#2563EB"];
  app [label="外部服务\nPod 实例标识与允许的操作", fillcolor="#DCFCE7", color="#16A34A"];
  work [label="工作区与业务结果\n替换后视为新实例\n旧通道不迁移", fillcolor="#F0FDF4"];
  oc -> app [dir=both,label="同 Pod 内的网络目标"];
  app -> work [dir=both,label="明确存储卷与权限"];
 }
 {rank=same;oa;ob;oc;}
 {rank=same;ex;ui;app;}
 {rank=same;ws;device;work;}
 ois -> oa [dir=both,label="　　OIC 主动出站　　\n　　中继传输　　"];
 ois -> ob [dir=both,label="　　OIC 主动出站　　\n　　中继传输　　"];
 ois -> oc [dir=both,label="　　OIC 主动出站　　\n　　中继传输　　"];
}
