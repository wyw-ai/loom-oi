digraph G {
graph [rankdir=BT,bgcolor="white",pad="0.4",nodesep="0.38",ranksep="0.65",fontname="Noto Sans SC",fontsize=23,labelloc=t,splines=polyline,newrank=true,label="loom-oi 整体理念｜由基础与共同契约支撑用户结果"];
node [shape=box,style="rounded,filled",fillcolor="#eef5ff",color="#5077a3",fontname="Noto Sans SC",fontsize=13,margin="0.25,0.20",width=3.2];
edge [fontname="Noto Sans SC",fontsize=11,color="#52677f",arrowsize=0.75];
subgraph cluster_external {
label="";color="#91b7a2";style=rounded;
business[label="业务提供方拥有\n业务能力与真实资源\n执行、会话、业务权限与结果",fillcolor="#e4f4e9"];
infra[label="部署方拥有\n环境与部署\n网络、身份、实例生命周期与存储",fillcolor="#e4f4e9"];
{rank=same;business;infra;}
}
subgraph cluster_oi {
label="";color="#7fa6cb";style=rounded;
objects[label="受控接入与准确对象\nAccess 身份／Exposure 目标版本"];
contracts[label="共同契约与状态归属\n授权、最终准入、有限许可\n有界运行状态、断流不重放",fillcolor="#dcecff",width=4.1];
discovery[label="发现与准入\n可见不等于允许或就绪"];
channel[label="通道与路径策略\nR 当前基线／H 研究候选\n路径变化仍服从共同契约"];
diagnosis[label="诊断与恢复\n传输状态与业务结果分开"];
{rank=same;discovery;channel;diagnosis;}
objects->contracts[label="身份与目标贯穿"];
contracts->discovery;contracts->channel;contracts->diagnosis;
}
outcome[label="完整用户结果\n发现并准确连接分散环境中的获准能力\n理解失败、恢复边界与总代价",fillcolor="#dbeee4",color="#4b8767",fontsize=16,width=7.7];
deploy[label="部署是另一维度，不能替代契约\nOIS／OIC／客户端共同实现职责\n路径和负载推导进程、主机与后端",shape=note,fillcolor="#fff1d6",color="#b58b49",width=5.1];
business->objects[label="受控端点与描述"];
infra->objects[label="允许接入的基础"];
discovery->outcome;channel->outcome;diagnosis->outcome;
channel->deploy[style=dashed,dir=both,label="机制与部署相互校验",constraint=false];
note[label="概念依赖图，不是五层进程或已实现拓扑\n自上而下推导能力与机制；自下而上核对权限、失败链和端到端成本\nH、具体接口与部署仍待评审；P1 R单实例纵向闭环已实现（ITER-004），其余能力未实现",shape=note,fillcolor="#f5f6f8",color="#9ca3af",width=9.5];
outcome->note[style=invis];
}
