digraph G {
 graph [rankdir=TB,bgcolor="white",pad="0.4",nodesep="0.45",ranksep="0.65",fontname="Noto Sans SC",fontsize=22,labelloc="t",splines=polyline,label="loom-oi 当前 R 基线｜核心通道与外部能力"];
 node [shape=box,style="rounded,filled",fillcolor="#eef5ff",color="#5077a3",fontname="Noto Sans SC",fontsize=12,width=3.6,margin="0.3,0.2",penwidth=1.3];
 edge [color="#52677f",fontname="Noto Sans SC",fontsize=11,arrowsize=0.8];
 subgraph cluster_consumer {
  label="消费方拥有业务身份与结果";fontsize=15;color="#b9d5c6";style="rounded";
  native[label="原生应用／脚本",fillcolor="#e4f4e9"];
  agent[label="智能体工具调用方",fillcolor="#e4f4e9"];
  adapter[label="可选外部工具适配\n明确目标与参数／脚本\n具体契约待评审",style="rounded,dashed,filled",fillcolor="#fff3d9",color="#a68142"];
  {rank=same; native; agent;}
  agent->adapter[label="结构化工具输入"];
 }
 subgraph cluster_oi {
  label="OI 核心\n登记、授权与有界传输";labeljust="c";fontsize=15;color="#a7c4e1";style="rounded";
  cli[label="oi 客户端／库\n发现、申请通道与附着"];
  ois[label="可信 OIS\n目录、策略与中继\nR 对照采用分模块与预算\n进程选择从路径与负载推导",fillcolor="#dcecff"];
  oic[label="OIC\n本地允许项与目标拨号\n观测与资源预算"];
  store[label="管理元数据\nPostgreSQL 或 SQLite",shape=cylinder,fillcolor="#fff1d6"];
  cli->ois[dir=both,label="认证后的数据连接"];
  oic->ois[dir=both,label="主动出站 WSS 控制连接\n与独立数据连接",constraint=false];
  ois->oic[style=invis];
  ois->store[dir=both,label="共同存储契约"];
  {rank=same; ois; store;}
 }
 subgraph cluster_provider {
  label="提供方拥有\n业务执行、权限与资源约束";labeljust="c";fontsize=15;color="#b9d5c6";style="rounded";
  service[label="外部能力服务\n命令／界面控制／HTTP／设备",fillcolor="#e4f4e9",color="#4b8767"];
  owner[label="用户／进程管理器／K8s\n负责安装与业务实例生命周期",fillcolor="#e4f4e9"];
  resource[label="获准的真实资源\nECS／文件／桌面／设备",fillcolor="#e4f4e9"];
  owner->service[label="部署与管理"];
  service->resource[label="业务操作与必要的互斥"];
  {rank=same; service; owner;}
 }
 native->cli[dir=both,label="原生字节流"];
 adapter->cli[dir=both,label="客户端通道契约"];
 oic->service[dir=both,label="固定获准目标与原生协议"];
 note[label="传输中断不判定业务失败或取消；OI 不隐式重放\nR 中继与外部业务生命周期已确认\nOIS／OIC 首版 Go 与状态／绑定边界已确认\nP1 R单实例纵向闭环已实现（G1实现级证据见ITER-004）\n观测、恢复、资源与真实兼容门槛仍待完成",width=8.6,shape=note,fillcolor="#f5f6f8",color="#9ca3af",fontsize=12];
 resource->note[style=invis];
}
