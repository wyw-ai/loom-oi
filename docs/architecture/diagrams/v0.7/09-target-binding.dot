digraph binding {
 graph [rankdir=TB, newrank=true, bgcolor="#F8FAFC", pad=0.4, nodesep=0.7, ranksep=0.65, fontname="Noto Sans SC", label="两路能力目标绑定｜准确绑定方向已采用\nB1／B2 为独立端点时的示例 · 尚未实现与实测", labelloc=t, fontsize=20, fontcolor="#0F172A"];
 node [shape=box, style="rounded,filled", fontname="Noto Sans SC", fontsize=12, color="#94A3B8", fillcolor="white", margin="0.3,0.2", width=3.6];
 edge [fontname="Noto Sans SC", fontsize=10, color="#64748B", arrowsize=0.7];
 a [label="调用方 A1\n明确选择 B1", fillcolor="#EDE9FE", color="#A78BFA"];
 c [label="调用方 C1\n明确选择 B2", fillcolor="#EDE9FE", color="#A78BFA"];
 subgraph cluster_oi {
  label="OI 通用接入与可信中继\n可共享 OIC／OIS，绑定不得混合"; fontsize=15; color="#2563EB"; style="rounded"; bgcolor="#EFF6FF"; margin=22;
  x [label="第一路通道\n主体、目标及版本固定\n本路许可与字节流", fillcolor="#DBEAFE", color="#2563EB"];
  y [label="第二路通道\n主体、目标及版本固定\n本路许可与字节流", fillcolor="#DBEAFE", color="#2563EB"];
 }
 b1 [label="外部能力端点 B1\n业务协议与状态由提供方管理", fillcolor="#DCFCE7", color="#16A34A"];
 b2 [label="外部能力端点 B2\n业务协议与状态由提供方管理", fillcolor="#DCFCE7", color="#16A34A"];
 limits [label="通道分开不等于资源独立\n共同进程故障仍可影响两路\n共享冲突见图８；内部句柄归原协议", width=7.9, fillcolor="#FEF3C7", color="#D97706"];
 a -> x [dir=both,label="　授权与建连　"];
 c -> y [dir=both,label="　授权与建连　"];
 x -> b1 [dir=both,label="　固定目标，不改投　"];
 y -> b2 [dir=both,label="　固定目标，不改投　"];
 {rank=same;a;c;} {rank=same;x;y;} {rank=same;b1;b2;}
 b1 -> limits [style=invis]; b2 -> limits [style=invis];
}
